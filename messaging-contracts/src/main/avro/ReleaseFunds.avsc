{
  "type": "record",
  "name": "ReleaseFunds",
  "namespace": "com.ledgerflow.messaging",
  "doc": "Command on ledger.commands: compensation, move a reserved amount from the payments-in-transit account back to the debtor (ADR 0012). Key: paymentId.",
  "fields": [
    {"name": "paymentId", "type": "string", "doc": "UUID of the payment."},
    {"name": "debtorAccountId", "type": "string", "doc": "UUID of the ledger account credited back."},
    {"name": "amountMinorUnits", "type": "long", "doc": "Positive amount in minor units (ADR 0004)."},
    {"name": "currency", "type": "string", "doc": "ISO-4217 code."},
    {"name": "reason", "type": "string", "doc": "Why the transfer failed; returned unchanged in FundsReleased."}
  ]
}

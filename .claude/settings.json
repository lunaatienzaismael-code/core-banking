{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/test-summary.sh:*)",
      "Bash(./mvnw:*)",
      "Bash(mkdir -p .agents/tasks/:*)",
      "Bash(tee .agents/tasks/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push -u origin build/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin ci/*)",
      "Bash(scripts/gh-rest.sh:*)",
      "Bash(scripts/check-task-sync.sh)",
      "Bash(scripts/review-defects.sh)",
      "Bash(scripts/state.sh:*)",
      "Bash(scripts/guard-paths.sh --check:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +*)",
      "Bash(git push --delete:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*merge*)",
      "Bash(gh api:*human-approved*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh", "timeout": 120 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-paths.sh", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/verify.sh", "timeout": 600 }]
      }
    ]
  }
}
